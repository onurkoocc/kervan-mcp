{
  "name": "kervan-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Kervan MCP resource server: customer tools over Streamable HTTP, guarded by kervan-auth tokens",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js",
    "docs:tools": "npm run build && node dist/tools-doc.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.3.0",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
